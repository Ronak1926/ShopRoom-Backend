# Firebase Admin SDK — get these from Firebase Console > Project Settings > Service accounts > Generate new private key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Database
DATABASE_URL=your-postgres-connection-string

# JWT
JWT_SECRET=your-jwt-secret

# Message encryption (at-rest AES-GCM for chat text) — key is derived from JWT_SECRET
MESSAGE_ENCRYPTION_ALGORITHM=aes-256-gcm
MESSAGE_ENCRYPTION_IV_LENGTH=12
MESSAGE_ENCRYPTION_AUTH_TAG_LENGTH=16

# Stock image providers (Notification Studio > Images > Stock tab) — optional,
# either or both may be set. Search degrades gracefully when unset.
PEXELS_API_KEY=your-pexels-api-key
UNSPLASH_ACCESS_KEY=your-unsplash-access-key

# Public address of the web app. Password-reset and invite links are built from it (required in production).
FRONTEND_BASE_URL=http://localhost:3000

# Browser sessions live in HttpOnly cookies set by this API, so scripts on the page can never read them.
# - CORS_ORIGINS: the exact address(es) of the web app, comma separated (required in production), for example
#   https://app.example.com . Cookies are only accepted from these origins on writes (CSRF protection).
# - Host the API on a subdomain of the SAME SITE as the web app (app.example.com + api.example.com). Browsers
#   refuse to send a SameSite=Lax cookie between unrelated sites (for example vercel.app + onrender.com).
# - COOKIE_DOMAIN: leave empty unless the web app must read cookies the API set (it does not).
# - COOKIE_SAMESITE: lax (default) | strict | none. "none" is only for web app and API on different sites; it forces
#   Secure and browsers that block third-party cookies will still not work.
CORS_ORIGINS=
COOKIE_DOMAIN=
COOKIE_SAMESITE=

# Email (OTP, password reset, contact form)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Where the contact form delivers; defaults to SMTP_USER
CONTACT_EMAIL=

# ─── Razorpay (payments) ─────────────────────────────────────────────────────
# Dashboard → Settings → API Keys → Generate Key. The Key ID is public (the browser needs it);
# the Key Secret is private. Use test keys (rzp_test_…) while developing and live keys
# (rzp_live_…) in production: the server refuses to start in production with a malformed
# Key ID and warns when it is a test key. Leave both empty in development to use mock payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ─── Razorpay webhook secret ─────────────────────────────────────────────────
# Dashboard → Settings → Webhooks → Add New Webhook, then type a long random secret
# (e.g. `openssl rand -hex 32`) into BOTH the dashboard and here. This is NOT the API Key Secret.
#   Webhook URL: https://<your-api-domain>/api/shopkeeper/payment/webhook
#   Active events: order.paid, payment.captured, payment.failed, refund.processed
# It is what completes a purchase when the buyer closes the tab before the confirmation reaches us.
RAZORPAY_WEBHOOK_SECRET=

# GST tax invoices (shopkeepers see an "Invoice" link next to each payment).
# Off until ALL of the first five are set and valid; the code assumes none of them, so have an
# accountant confirm the values. Prices customers see are treated as GST-INCLUSIVE.
INVOICE_SELLER_NAME=
INVOICE_SELLER_GSTIN=
INVOICE_SELLER_ADDRESS=
# Services Accounting Code printed on the invoice (4 to 8 digits)
INVOICE_SAC=
# GST rate in percent, for example 18
INVOICE_GST_RATE=
# Start of every invoice number (A-Z and 0-9, up to 8 characters). Default SR gives SR/2026-27/000001
INVOICE_PREFIX=
