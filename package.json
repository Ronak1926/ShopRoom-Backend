{
  "name": "shoproom-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "seed": "tsx prisma/seed.ts",
    "seed:notifications": "tsx prisma/seedNotificationsOnly.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test --test-concurrency=1 \"src/**/*.test.ts\"",
    "test:db:setup": "node scripts/setupTestDb.mjs",
    "db:verify-backup": "node scripts/verifyBackup.mjs",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.9",
    "@types/nodemailer": "^8.0.2",
    "nodemon": "^3.1.14",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "axios": "^1.21.0",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "firebase-admin": "^13.10.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.3.1",
    "razorpay": "^2.9.8",
    "socket.io": "^4.8.4",
    "stripe": "^22.6.2",
    "twilio": "^6.2.0",
    "zod": "^4.6.7"
  }
}
